# ==============================================================================
# UET Societies Hub - Environment Configuration (.env.example)
# ==============================================================================

# Client-side configuration (Safe for Flutter mobile app bundle)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Server-side ONLY (Edge Functions secrets / CI-CD - NEVER commit or bundle in client app)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Custom SMTP (Brevo / Resend) credentials for Supabase Auth Settings
# Configure in: Supabase Dashboard -> Authentication -> Email Templates & SMTP Settings
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login-email@example.com
SMTP_PASS=your-smtp-master-password
SMTP_SENDER_EMAIL=societies-noreply@uet.edu.pk
SMTP_SENDER_NAME="UET Societies Hub"
